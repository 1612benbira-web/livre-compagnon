# Environnement : development | production | test
NODE_ENV=development
PORT=5000
# MongoDB local (mongosh) en développement ; URI Atlas en production
MONGODB_URI=mongodb://127.0.0.1:27017/livre_compagnon
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Origine exacte du frontend (CORS + vérification de l'en-tête Origin)
CLIENT_URL=http://localhost:5173
# Fuseau horaire de référence pour la question du jour
APP_TIMEZONE=Africa/Dakar
# lax (défaut) | none si le frontend et l'API sont sur des domaines différents (HTTPS requis)
COOKIE_SAMESITE=lax
# Adresse publique encodée dans les QR codes (défaut : CLIENT_URL). À renseigner si le domaine public diffère.
# PUBLIC_BASE_URL=https://ton-domaine.com
# Emails « mot de passe oublié » via Resend (https://resend.com). Sans clé : lien affiché dans la console en développement.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Expéditeur : adresse d'un domaine vérifié dans Resend (onboarding@resend.dev n'envoie qu'à l'adresse de ton compte Resend)
# EMAIL_FROM=Livre compagnon <noreply@ton-domaine.com>
# Délai (ms) de connexion à MongoDB, à augmenter sur une connexion lente (défaut 5000)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
